# ================================================================
# MahaSkills / Skill & Employment Outcomes Intelligence
# Frontend (V1) Environment Configuration Example
# ================================================================
# NOTE: In Vite, only variables prefixed with VITE_ are exposed to the browser.
# NEVER put sensitive secrets (API keys, DB URLs) in frontend env files.

# Backend API Base URL (must point to the Express backend /api endpoint)
# For local development: http://localhost:5000/api
# For production deployment: https://api.mahaskills.gov.in/api
VITE_API_URL="http://localhost:5000/api"
