# ================================================================
# MahaSkills / Skill & Employment Outcomes Intelligence
# Backend Environment Configuration Example
# ================================================================
# NOTE: Copy this file to .env and fill in real production secrets.
# NEVER commit .env to version control.

# Server Configuration
PORT=5000
NODE_ENV=production

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/mahaskills_db?schema=public"

# Authentication & JWT
# Minimum 32-character random cryptographic string
JWT_SECRET="replace_with_a_long_random_cryptographic_secret_minimum_32_characters"

# CORS & Allowed Origins
CORS_ORIGIN="https://mahaskills.gov.in"
FRONTEND_URL="http://localhost:5173"
FRONTEND_V2_URL="http://localhost:5174"

# Resend Email Service (Transactional OTP & Notifications)
# Resend API Key from https://resend.com/api-keys
RESEND_API_KEY="re_123456789_placeholder"

# Verified Sender Email (Must match verified Resend domain, e.g., kluniversity.email)
# Note: Verified domain is the SENDER domain only. OTP delivery works for all recipient domains.
RESEND_FROM_EMAIL="MahaSkills Outcomes <noreply@kluniversity.email>"

# Python FastAPI Machine Learning Service URL
# Local: http://localhost:8000
# Production (Render/Railway/Koyeb): https://mahaskills-ml-service.onrender.com
ML_SERVICE_URL="http://localhost:8000"
